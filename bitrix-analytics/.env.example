# Скопируйте этот файл в .env и заполните. Файл .env НИКОГДА не коммитится в git.

# Входящий вебхук Битрикс24 (см. docs/BITRIX_WEBHOOK.md). Содержит секретный код — храните в тайне.
BITRIX_WEBHOOK_URL=https://ВАШ-ПОРТАЛ.bitrix24.ru/rest/1/КОД_ВЕБХУКА/

# База данных. Пароль придумайте свой: длинный, только латинские буквы и цифры.
POSTGRES_USER=analytics
POSTGRES_PASSWORD=ЗАМЕНИТЕ_НА_СВОЙ_ПАРОЛЬ
POSTGRES_DB=analytics

# Необязательно (значения по умолчанию):
# SYNC_INTERVAL_MINUTES=10     # как часто подтягивать изменения из Битрикс24
# RECONCILE_HOUR=3             # час (UTC), когда ночью искать удалённые сделки
# BITRIX_MIN_INTERVAL_SEC=0.5  # пауза между запросами к Битрикс24 (лимит облака ~2 запроса/сек)
